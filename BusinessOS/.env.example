# ─────────────────────────────────────────────────────────────
# BusinessOS — Environment Configuration
# Copy this file to ../.env (the Calendar root) and fill in values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Paste your Render PostgreSQL connection string here.
# Render format:  postgres://user:password@host.render.com:5432/dbname
# Local format:   postgresql://postgres:password@localhost:5432/businessos
DATABASE_URL=postgresql://user:password@localhost:5432/businessos

# ── Business info (Michigan) ──────────────────────────────────
EMPLOYER_STATE=MI
EMPLOYER_EIN=XX-XXXXXXX
BUSINESS_NAME=Your Business Name
OWNER_EMAIL=you@yourbusiness.com

# ── Flask ─────────────────────────────────────────────────────
# Generate a secure key:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# ── Time clock ────────────────────────────────────────────────
SCHEDULER_TIMEZONE=America/Detroit

# ── Optional ─────────────────────────────────────────────────
REVIEW_LINK=https://g.page/r/your-google-review-link
ADMIN_PIN=1234
